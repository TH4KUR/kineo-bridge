// kineo_probe_v2.rc — PE version resource for the M1 probe CTI.
// Added as a single-variable test after comparing against the real IDS CTI
// (which is Authenticode-signed AND carries a full version resource, while
// our mingw-built probe had neither) -- see investigation/progress.md M1
// section for the reasoning. Testing the (cheap, benign) version-resource
// variable first, before considering the (expensive, requires a purchased
// cert) signing variable.
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L   // VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IDS Imaging Development Systems GmbH"
            VALUE "FileDescription", "Kineo Bridge Probe GenTL Producer (M1 test build)"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "kineo_probe_v2"
            VALUE "LegalCopyright", "IMV Technologies"
            VALUE "OriginalFilename", "kineo_probe_v2.cti"
            VALUE "ProductName", "Kineo Bridge GenTL Producer"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
